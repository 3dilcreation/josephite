# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Google OAuth2 (Calendar + Gmail) ────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Google Calendar API + Gmail API
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
GOOGLE_REFRESH_TOKEN=your_google_refresh_token   # run: npm run oauth

# ─── Google Calendar ──────────────────────────────────────────────────────────
GOOGLE_CALENDAR_ID=primary          # or paste the calendar ID from Google Calendar settings
CALENDAR_TIMEZONE=Asia/Kolkata

# ─── Gmail sender ─────────────────────────────────────────────────────────────
EMAIL_USER=3dilcreation@gmail.com
OWNER_EMAIL=3dilcreation@gmail.com  # where owner notifications go

# ─── Shopify webhook ─────────────────────────────────────────────────────────
# Shopify Admin → Settings → Notifications → Webhooks → orders/create
# Copy the webhook signing secret here:
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_signing_secret

# ─── WhatsApp Business API (Meta) ────────────────────────────────────────────
# Meta Developer → App → WhatsApp → Configuration → Webhook
# Callback URL: https://yourdomain.com/webhooks/whatsapp
# Fields to subscribe: messages
WHATSAPP_VERIFY_TOKEN=choose_any_secret_string   # matches what you enter in Meta dashboard
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# ─── Instagram (Meta Graph API) ──────────────────────────────────────────────
# Meta Developer → App → Instagram → Webhooks
# Callback URL: https://yourdomain.com/webhooks/instagram
# Fields to subscribe: messages
INSTAGRAM_VERIFY_TOKEN=choose_any_secret_string  # matches what you enter in Meta dashboard
INSTAGRAM_ACCESS_TOKEN=your_meta_instagram_access_token
