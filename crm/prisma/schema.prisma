// 3DIL CREATION — CRM data model
// Multi-tenant from day one: every business row hangs off an Organization and,
// where it belongs to a place, a Branch. Running one location today costs
// nothing; adding branches or franchisees later needs no migration of meaning.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN // owner: everything, all branches, billing, integrations
  ADMIN // branch admin: everything inside their branch
  MANAGER // department head: their department's work, can reassign
  STAFF // executes work assigned to them / their department
  VIEWER // read-only (accountant, auditor, investor)
}

enum BranchType {
  HQ
  BRANCH
  FRANCHISE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Channel {
  ONLINE
  OFFLINE
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  DESIGN
  PRINTING
  POST_PROCESSING
  QUALITY_CHECK
  READY
  SHIPPED
  DELIVERED
  ON_HOLD
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERDUE
  REFUNDED
}

enum PaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  CHEQUE
  COD
  GATEWAY
  OTHER
}

enum PrintTechnology {
  FDM
  SLA
  SLS
  MJF
  DMLS
  POLYJET
  DLP
  OTHER
}

// Where a lead or order came from. Adding a marketplace later is one enum value
// plus one adapter file — the rest of the app already handles it.
enum SourceKind {
  MANUAL
  WEBSITE
  SHOPIFY
  WOOCOMMERCE
  AMAZON
  FLIPKART
  ETSY
  INDIAMART
  WHATSAPP
  INSTAGRAM
  FACEBOOK_LEADS
  GOOGLE_ADS
  PHONE
  WALK_IN
  REFERRAL
  EXHIBITION
  OTHER
}

enum NotificationType {
  LEAD_ASSIGNED
  LEAD_STALE
  ORDER_ASSIGNED
  ORDER_STATUS_CHANGED
  ORDER_DUE_SOON
  ORDER_OVERDUE
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  MENTION
  SYSTEM
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum EntityType {
  LEAD
  ORDER
  CUSTOMER
  PAYMENT
  USER
}

// ---------------------------------------------------------------------------
// Tenancy & people
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  gstin     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches     Branch[]
  departments  Department[]
  users        User[]
  customers    Customer[]
  leads        Lead[]
  orders       Order[]
  sources      IntegrationSource[]
  activities   Activity[]
  notifications Notification[]
  materials    Material[]
  machines     Machine[]
  quotes       Quote[]
  pricing      PricingSetting?
}

model Branch {
  id      String     @id @default(cuid())
  orgId   String
  name    String
  code    String
  type    BranchType @default(BRANCH)
  city    String?
  state   String?
  address String?
  phone   String?
  email   String?
  // Franchise economics — ignored for HQ/BRANCH, used for royalty reporting.
  royaltyPercent Decimal? @db.Decimal(5, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  users     User[]
  customers Customer[]
  leads     Lead[]
  orders    Order[]
  machines  Machine[]
  quotes    Quote[]

  @@unique([orgId, code])
  @@index([orgId])
}

model Department {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String?
  colour      String   @default("#64748b")
  createdAt   DateTime @default(now())

  org      Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members  UserDepartment[]
  leads    Lead[]
  orders   Order[]

  @@unique([orgId, slug])
  @@index([orgId])
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  branchId     String?
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         Role     @default(STAFF)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org         Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch      Branch?          @relation(fields: [branchId], references: [id])
  departments UserDepartment[]

  ownedCustomers   Customer[]     @relation("CustomerOwner")
  createdQuotes    Quote[]
  assignedLeads    Lead[]         @relation("LeadAssignee")
  assignedOrders   Order[]        @relation("OrderAssignee")
  notes            Note[]
  activities       Activity[]
  notifications    Notification[]
  recordedPayments Payment[]      @relation("PaymentRecorder")

  @@index([orgId])
  @@index([branchId])
}

// A user can sit in more than one department (common in a <20-person shop where
// one person does both sales and post-processing).
model UserDepartment {
  userId       String
  departmentId String
  isLead       Boolean @default(false)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
}

// ---------------------------------------------------------------------------
// Commercial records
// ---------------------------------------------------------------------------

model Customer {
  id       String  @id @default(cuid())
  orgId    String
  branchId String?
  name     String
  company  String?
  email    String?
  phone    String?
  gstin    String?
  address  String?
  city     String?
  state    String?
  pincode  String?
  tags     String[] @default([])
  notesText String?
  ownerId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch Branch?      @relation(fields: [branchId], references: [id])
  owner  User?        @relation("CustomerOwner", fields: [ownerId], references: [id])
  leads  Lead[]
  orders Order[]
  quotes Quote[]

  @@index([orgId])
  @@index([orgId, phone])
  @@index([orgId, email])
}

model Lead {
  id          String     @id @default(cuid())
  orgId       String
  branchId    String?
  customerId  String?
  title       String
  contactName String?
  email       String?
  phone       String?
  company     String?
  requirement String?
  status      LeadStatus @default(NEW)
  priority    Priority   @default(MEDIUM)
  channel     Channel    @default(ONLINE)
  sourceKind  SourceKind @default(MANUAL)
  sourceId    String?
  externalId  String?
  externalUrl String?
  estimatedValue Decimal? @db.Decimal(12, 2)
  expectedCloseDate DateTime?
  assignedToId String?
  departmentId String?
  lostReason   String?
  lastActivityAt DateTime @default(now())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch     Branch?            @relation(fields: [branchId], references: [id])
  customer   Customer?          @relation(fields: [customerId], references: [id])
  assignedTo User?              @relation("LeadAssignee", fields: [assignedToId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  source     IntegrationSource? @relation(fields: [sourceId], references: [id])
  orders     Order[]
  quotes     Quote[]

  @@unique([sourceId, externalId])
  @@index([orgId, status])
  @@index([orgId, priority])
  @@index([orgId, createdAt])
  @@index([assignedToId])
}

model Order {
  id          String        @id @default(cuid())
  orgId       String
  branchId    String?
  orderNo     String
  customerId  String
  leadId      String?
  status      OrderStatus   @default(CONFIRMED)
  priority    Priority      @default(MEDIUM)
  channel     Channel       @default(OFFLINE)
  sourceKind  SourceKind    @default(MANUAL)
  sourceId    String?
  externalId  String?
  externalUrl String?
  currency    String        @default("INR")
  subtotal    Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount   Decimal       @default(0) @db.Decimal(12, 2)
  shipping    Decimal       @default(0) @db.Decimal(12, 2)
  discount    Decimal       @default(0) @db.Decimal(12, 2)
  total       Decimal       @default(0) @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(12, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentDueDate DateTime?
  dueDate      DateTime?
  deliveredAt  DateTime?
  assignedToId String?
  departmentId String?
  shippingAddress String?
  trackingNumber  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  org        Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch     Branch?            @relation(fields: [branchId], references: [id])
  customer   Customer           @relation(fields: [customerId], references: [id])
  lead       Lead?              @relation(fields: [leadId], references: [id])
  assignedTo User?              @relation("OrderAssignee", fields: [assignedToId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  source     IntegrationSource? @relation(fields: [sourceId], references: [id])
  items      OrderItem[]
  payments   Payment[]

  @@unique([orgId, orderNo])
  @@unique([sourceId, externalId])
  @@index([orgId, status])
  @@index([orgId, paymentStatus])
  @@index([orgId, dueDate])
  @@index([orgId, createdAt])
  @@index([assignedToId])
}

// The 3D-printing specifics live on the line item, not the order: one order can
// mix an SLA resin prototype with a batch of FDM jigs, each with its own cost
// drivers.
model OrderItem {
  id          String           @id @default(cuid())
  orderId     String
  name        String
  description String?
  technology  PrintTechnology?
  material    String?
  colour      String?
  quantity    Int              @default(1)
  unitPrice   Decimal          @default(0) @db.Decimal(12, 2)
  // Cost drivers — what actually makes a print expensive.
  weightGrams  Decimal? @db.Decimal(10, 2)
  printHours   Decimal? @db.Decimal(10, 2)
  layerHeightMm Decimal? @db.Decimal(6, 3)
  infillPercent Int?
  fileName     String?
  fileUrl      String?
  notes        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Payment {
  id            String        @id @default(cuid())
  orderId       String
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod @default(UPI)
  reference     String?
  paidAt        DateTime      @default(now())
  recordedById  String?
  note          String?
  createdAt     DateTime      @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User? @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([orderId])
  @@index([paidAt])
}

// ---------------------------------------------------------------------------
// Collaboration, audit, alerts
// ---------------------------------------------------------------------------

// Notes are polymorphic so the same comment box works on a lead, an order or a
// customer without three near-identical tables.
model Note {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  body       String
  isPinned   Boolean    @default(false)
  authorId   String?
  createdAt  DateTime   @default(now())

  author User? @relation(fields: [authorId], references: [id])

  @@index([entityType, entityId])
}

// Append-only audit trail. Answers "who changed this order's price, and when".
model Activity {
  id         String     @id @default(cuid())
  orgId      String
  entityType EntityType
  entityId   String
  action     String
  summary    String
  meta       Json?
  actorId    String?
  createdAt  DateTime   @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor User?        @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([orgId, createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  orgId     String
  userId    String
  type      NotificationType
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

// One row per connected channel. `secret` signs the inbound webhook so only the
// real site can post leads; `config` holds per-channel settings (field maps,
// default department, default priority).
model IntegrationSource {
  id          String     @id @default(cuid())
  orgId       String
  key         String
  name        String
  kind        SourceKind
  secret      String
  isActive    Boolean    @default(true)
  defaultDepartmentId String?
  defaultBranchId     String?
  config      Json?
  lastEventAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  org    Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leads  Lead[]
  orders Order[]
  events WebhookEvent[]

  @@unique([orgId, key])
  @@index([orgId])
}

// Every inbound payload is stored raw before it is interpreted, so a bad
// mapping can be fixed and the event replayed instead of lost.
model WebhookEvent {
  id          String        @id @default(cuid())
  sourceId    String
  status      WebhookStatus @default(RECEIVED)
  payload     Json
  error       String?
  resultType  EntityType?
  resultId    String?
  createdAt   DateTime      @default(now())
  processedAt DateTime?

  source IntegrationSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt])
}

// ---------------------------------------------------------------------------
// Quoting, materials and machines
//
// These three exist together on purpose: a quote is only as good as the rates
// behind it, and the same rates are what let an order report a real margin
// rather than a guess.
// ---------------------------------------------------------------------------

enum MachineStatus {
  IDLE
  PRINTING
  MAINTENANCE
  OFFLINE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

model Material {
  id         String          @id @default(cuid())
  orgId      String
  name       String
  technology PrintTechnology
  brand      String?
  colour     String?
  // Density decides grams from volume; cost decides rupees from grams. Both are
  // per-material because PLA and PA12 differ by more than 2x on each.
  densityGramsPerCm3 Decimal @db.Decimal(6, 3)
  costPerGram        Decimal @db.Decimal(10, 4)
  // Purge, supports that get binned, and the share of prints that fail. Folded
  // into every quote so the failure rate is priced in rather than absorbed.
  wastePercent Decimal @default(10) @db.Decimal(5, 2)
  stockGrams        Decimal @default(0) @db.Decimal(12, 2)
  reorderLevelGrams Decimal @default(0) @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  quotes Quote[]

  @@unique([orgId, name])
  @@index([orgId, technology])
}

model Machine {
  id         String          @id @default(cuid())
  orgId      String
  branchId   String?
  name       String
  technology PrintTechnology
  model      String?
  buildXmm   Int?
  buildYmm   Int?
  buildZmm   Int?
  // What the machine costs to run for an hour: depreciation, power, and the
  // share of the operator's time it consumes.
  hourlyRate Decimal @db.Decimal(10, 2)
  // Effective throughput at the reference layer height, measured from real jobs
  // rather than the manufacturer's number.
  cm3PerHour Decimal @default(15) @db.Decimal(8, 2)
  referenceLayerMm Decimal @default(0.2) @db.Decimal(5, 3)
  status    MachineStatus @default(IDLE)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch Branch?      @relation(fields: [branchId], references: [id])
  quotes Quote[]

  @@unique([orgId, name])
  @@index([orgId, technology])
}

// One row per organisation. The knobs that turn cost into price.
model PricingSetting {
  id                 String  @id @default(cuid())
  orgId              String  @unique
  setupFee           Decimal @default(250) @db.Decimal(10, 2)
  minimumCharge      Decimal @default(500) @db.Decimal(10, 2)
  labourRatePerHour  Decimal @default(250) @db.Decimal(10, 2)
  postProcessMinutes Int     @default(15)
  marginPercent      Decimal @default(45) @db.Decimal(5, 2)
  rushMultiplier     Decimal @default(1.5) @db.Decimal(5, 2)
  // Above this value a human checks the number before it goes to the customer.
  reviewThreshold Decimal  @default(25000) @db.Decimal(12, 2)
  quoteValidDays  Int      @default(15)
  updatedAt       DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Quote {
  id       String @id @default(cuid())
  orgId    String
  branchId String?
  quoteNo  String
  customerId String?
  leadId     String?

  // What the uploaded model measured. Kept so a quote can be re-costed later
  // against different rates without asking the customer to re-send the file.
  fileName      String
  fileSizeBytes Int
  triangleCount Int
  volumeCm3     Decimal @db.Decimal(12, 4)
  bboxXmm       Decimal @db.Decimal(10, 2)
  bboxYmm       Decimal @db.Decimal(10, 2)
  bboxZmm       Decimal @db.Decimal(10, 2)

  technology    PrintTechnology
  materialId    String?
  machineId     String?
  quantity      Int     @default(1)
  infillPercent Int     @default(20)
  layerHeightMm Decimal @default(0.2) @db.Decimal(5, 3)
  isRush        Boolean @default(false)

  estimatedGrams Decimal @db.Decimal(12, 2)
  estimatedHours Decimal @db.Decimal(10, 2)
  materialCost   Decimal @db.Decimal(12, 2)
  machineCost    Decimal @db.Decimal(12, 2)
  labourCost     Decimal @db.Decimal(12, 2)
  setupCost      Decimal @db.Decimal(12, 2)
  totalCost      Decimal @db.Decimal(12, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  needsReview    Boolean @default(false)

  status      QuoteStatus @default(DRAFT)
  validUntil  DateTime?
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  branch    Branch?      @relation(fields: [branchId], references: [id])
  customer  Customer?    @relation(fields: [customerId], references: [id])
  lead      Lead?        @relation(fields: [leadId], references: [id])
  material  Material?    @relation(fields: [materialId], references: [id])
  machine   Machine?     @relation(fields: [machineId], references: [id])
  createdBy User?        @relation(fields: [createdById], references: [id])

  @@unique([orgId, quoteNo])
  @@index([orgId, status])
  @@index([orgId, createdAt])
}
